{
	email ops@example.invalid
	auto_https disable_redirects
}
:80 {
	redir https://{host}{uri} permanent
}
music.example.invalid {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
	encode gzip
	@callback path /wecom/callback
	log_skip @callback
	# Preserve callback query parameters: WeCom signature validation needs them.
	handle @callback {
		reverse_proxy musicdl:8000
	}
	@static path /static/*
	handle @static {
		header Cache-Control "public, max-age=604800, immutable"
		file_server
	}
	# Everything else is one process: the console's pages and assets, and the
	# /admin routes they call. There is no second upstream to route to and no
	# path to strip, so the catch-all below is the whole configuration.
	handle {
		reverse_proxy musicdl:8000
	}
	log {
		output file /var/log/caddy/access.json
		format json
	}
}
