# External Redis is required; do not commit real credentials.
# Replace the example host with your externally managed Redis endpoint.
MUSICDL_REDIS__URL=redis://redis.example.invalid:6379/0
# Optional host bind port for the main health/API endpoint.
MUSICDL_PORT=8000
# Optional host bind port for the administration panel.
#
# The panel is built against the app's Compose service name, so there is no
# matching variable for the app's address: `docker compose` supplies it.
MUSICDL_ADMIN_PORT=3000
# Optional OpenAI-compatible advisory ranking/classification (disabled by default).
# MUSICDL_AI__ENABLED=false
# MUSICDL_AI__BASE_URL=https://api.openai.com/v1
# MUSICDL_AI__API_KEY=replace-with-a-secret
# MUSICDL_AI__MODEL=replace-with-a-compatible-model
# MUSICDL_AI__TIMEOUT=10
# MUSICDL_AI__MAX_CANDIDATES=20
# Optional: relays that only answer a specific client reject the default
# User-Agent with 401. Leave blank to use the HTTP client's own value.
# MUSICDL_AI__USER_AGENT=claude-cli/1.0.0 (external, cli)
