# 可选部署配置。复制为 .env 并按需修改；不创建 .env 也能直接启动。
# Compose 会把此文件的 MUSICDL_* 应用设置传给 musicdl 服务。
# MUSICDL_PORT、MUSICDL_BIND_HOST、MUSICDL_IMAGE_TAG 是 Compose 变量，应用会忽略它们。
# 音乐目录、会话目录、后台状态路径和 Redis 地址由 compose.yaml 固定，以匹配具名卷和内置 Redis。
# 请勿提交真实凭据。

# 宿主机绑定。默认只允许本机访问；可信局域网中如确有需要可改成 0.0.0.0。
# 对外服务应通过 HTTPS 反向代理保护，不要直接暴露管理端口。
MUSICDL_BIND_HOST=127.0.0.1
MUSICDL_PORT=8000

# 固定到已发布版本以便升级和回滚。两个 musicdl 镜像使用相同标签。
MUSICDL_IMAGE_TAG=1.2.0

# full 保留完整功能；lite 会关闭 WeCom 功能，但本 Compose 仍会启动内置 Redis。
MUSICDL_DEPLOYMENT_MODE=full

# 默认支持本机 loopback HTTP 登录 Cookie。HTTPS 反向代理部署请改为 true。
MUSICDL_ADMIN__COOKIE_SECURE=false

# 下载文件时如何校验目录时长。
# lenient（默认）：已知时长不符时拒绝预览或半成品；无法校验时接受并记录事件。
# strict：无法校验时也拒绝。
# MUSICDL_MEDIA__VERIFY_DURATION=lenient

# 可选 OpenAI 兼容 AI 辅助（默认关闭）。启用后需要 API_KEY 和 MODEL。
# MUSICDL_AI__ENABLED=false
# MUSICDL_AI__BASE_URL=https://api.openai.com/v1
# MUSICDL_AI__API_KEY=replace-with-a-secret
# MUSICDL_AI__MODEL=replace-with-a-compatible-model
# MUSICDL_AI__TIMEOUT=10
# MUSICDL_AI__MAX_CANDIDATES=20
# MUSICDL_AI__USER_AGENT=claude-cli/1.0.0 (external, cli)

# 默认优先无损格式；文件会更大。可改为 best_available。
MUSICDL_WORKER__QUALITY_POLICY=lossless_first
# 支持的可选等级：flac 或 320k。
# MUSICDL_WORKER__QUALITY_PREFERENCE=flac

# Telegram、企业微信等功能可在管理面板配置；如需在容器启动时提供设置，
# 可在此添加 MUSICDL_TELEGRAM__* 或 MUSICDL_WECOM__* 变量。
